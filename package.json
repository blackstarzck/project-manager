{
  "name": "project-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@xyflow/react": "^12.0.0",
    "elkjs": "^0.11.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "~3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "storybook": "10.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
